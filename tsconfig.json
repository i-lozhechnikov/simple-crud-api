{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
  ],
  "include": [
    "src/**/*.ts",
  ]
}
